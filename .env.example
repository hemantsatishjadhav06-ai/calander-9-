# CORE
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY_SALT=change-me-to-a-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000
# Production Compose (Compose v2.24+): the public hostname Caddy obtains TLS for.
# APP_DOMAIN=app.example.com
# Only set behind a TLS-terminating proxy you run. Accepts addresses and
# CIDR ranges. Left empty, X-Forwarded-For is ignored and every visitor
# shares one rate-limit bucket, so one person's failed logins lock out
# everyone. Managed platforms forward from a range rather than a stable
# address (Railway: 100.64.0.0/10).
# BB_TRUSTED_PROXIES=100.64.0.0/10

# DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightbean
# Production Compose requires this and a matching DATABASE_URL whose host is
# postgres. URL-encode special characters in the password in DATABASE_URL.
# POSTGRES_PASSWORD=<generate-a-strong-database-password>
# Required in multi-process production; Compose configures its private Redis.
REDIS_URL=

# STORAGE
STORAGE_BACKEND=local
# In the docker-compose deployment this has to stay /app/media: that is where
# the media_data volume is mounted, and where the Caddyfile's /media/ handler
# reads from. Point it elsewhere there and uploads 404 at the proxy.
MEDIA_ROOT=/app/media
# With STORAGE_BACKEND=local, Django serves MEDIA_ROOT at /media/, unauthenticated
# — that is required, because Instagram, Threads, Facebook, Pinterest, Google
# Business and dev.to fetch attachment URLs server-side when publishing. Set to
# false only when a reverse proxy or CDN serves MEDIA_ROOT on the same public
# path instead (the docker-compose.prod.yml + Caddyfile setup already does, so
# there the value is moot). Ignored entirely with STORAGE_BACKEND=s3.
SERVE_MEDIA=true
# Confirm only after MEDIA_ROOT is a durable volume shared by web and worker.
# The production Compose manifest supplies this automatically.
MEDIA_STORAGE_PERSISTENT=false
# Only the subtrees listed in PUBLIC_MEDIA_PREFIXES (config/urls.py) are
# reachable that way — media library assets, avatars and workspace icons.
# Comment attachments go through a permission-checked view instead.
#
# docker-compose only: Caddy's read-only uploads volume. Production Compose
# keeps this aligned with MEDIA_ROOT and disables it when STORAGE_BACKEND=s3.
CADDY_MEDIA_ROOT=/app/media
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto
# Bytes an object may occupy in memory before the read spools to disk. Leave it
# alone unless you know why: django-storages' own default (0) means "never spool",
# which holds whole videos in RAM and is how a small dyno runs out of memory.
AWS_S3_MAX_MEMORY_SIZE=2097152

# EMAIL
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Enable once transactional mail delivery has been verified.
ACCOUNT_EMAIL_VERIFICATION=none

# GOOGLE AUTH (user login/signup - separate from platform credentials below)
# "Sign in with Google" shows on the login and signup pages once both are set.
# Google Cloud Console -> Credentials -> OAuth client ID (Web application), with
# the authorized redirect URI {APP_URL}/accounts/google/login/callback/
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# PLATFORM CREDENTIALS — set per deployment here (these take precedence), or
# per organization via the Django admin at /admin/ -> Platform credentials.
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
# Optional but recommended for agency/multi-business onboarding.
PLATFORM_FACEBOOK_CONFIG_ID=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
# Threads - NOT the Facebook App ID. A Meta app with the "Access the Threads API"
# use case gets its own pair, shown as "Threads App ID" / "Threads App Secret"
# under App settings -> Basic. Threads stays unconfigured until both are set.
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=
# LinkedIn - see README "LinkedIn" section. Choose Path A or Path B (or both).
# Path B (Community Management API) credentials are automatically reused for
# personal connections, giving refresh tokens. Redirect URLs:
# {APP_URL}/social-accounts/callback/linkedin_company/ and .../linkedin_personal/
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
# Optional: the scopes to ask for, when the LinkedIn app's Auth tab lists a
# different set from the defaults (one ungranted scope fails the whole sign-in).
# PLATFORM_LINKEDIN_COMPANY_SCOPES=
# PLATFORM_LINKEDIN_PERSONAL_SCOPES=
# Legacy shared vars (still honored as fallback for both personal + company,
# assumed to be CM-approved). Leave commented unless migrating from an older install.
# PLATFORM_LINKEDIN_CLIENT_ID=
# PLATFORM_LINKEDIN_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=
# X (Twitter) - the OAuth 2.0 Client ID / Client Secret from console.x.com (app
# type "Web App", a confidential client), NOT the API Key / API Secret pair.
# Callback URL: {APP_URL}/social-accounts/callback/x/. X's API is pay-per-use
# with no free tier: each post, and each connection health check, spends credits
# on the developer account, so add credits before connecting. See README "X (Twitter)".
PLATFORM_X_CLIENT_ID=
PLATFORM_X_CLIENT_SECRET=

# UNSPLASH — optional; enables stock-photo search in the composer.
# Create a free app at https://unsplash.com/developers and paste its Access Key.
UNSPLASH_ACCESS_KEY=

# PUBLISHING
# Seconds a post may sit mid-publish before the confirmation sweep gives up on
# it. STALE covers a post whose worker died before reaching the platform;
# CONFIRM covers one the platform accepted and is still processing (TikTok
# transcodes after upload). Both end as a visible failure, never a silent retry.
PUBLISHER_STALE_PUBLISHING_TIMEOUT=900
PUBLISHER_PUBLISH_CONFIRM_TIMEOUT=1800
# And how long to keep retrying when the platform accepted the upload but we
# cannot reach it to ask the outcome. Much longer, because the post may already
# be live: every extra retry is a chance to learn that instead of warning the
# user about a duplicate we could have ruled out.
PUBLISHER_UNCONFIRMED_TIMEOUT=21600
# Publisher concurrency. PUBLISHES caps rows per cycle and costs nothing; the
# other two are a Postgres connection budget, not a throughput knob, because
# each publish thread holds its own connection. Keep POSTS + PLATFORM_PUBLISHES
# + the web dyno's gunicorn threads under the connection limit of your Postgres
# plan (20 for the whole role on Heroku essential-0). To pause publishing use
# `heroku ps:scale worker=0`, not a 0 here — these floor at 1.
PUBLISHER_MAX_CONCURRENT_PUBLISHES=10
PUBLISHER_MAX_CONCURRENT_POSTS=4
PUBLISHER_MAX_CONCURRENT_PLATFORM_PUBLISHES=6

# MONITORING
# Sentry performance sampling. Profiling is off by default - it keeps stack
# samples in memory, which a 512 MB dyno cannot spare.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# INBOUND WEBHOOKS
TELEGRAM_WEBHOOK_BASE_URL=
# Set true only after deploying and verifying the Telegram webhook route.
TELEGRAM_WEBHOOK_READY=false
# Human-consented company-bot creation still requires a paired manager bot
# reporting can_manage_bots=true. BotFather is the fallback.
TELEGRAM_MANAGED_BOTS_ENABLED=true
TELEGRAM_UPDATE_MAX_BYTES=262144
# Clear expired update/message content and review snapshots; keep receipt/audit IDs.
TELEGRAM_UPDATE_RETENTION_DAYS=7
TELEGRAM_DELIVERY_RETENTION_DAYS=30
TELEGRAM_ACTION_RETENTION_DAYS=30
TELEGRAM_PAIRING_RETENTION_DAYS=1
# Each client bot is connected in Agency -> Telegram; tokens are encrypted
# per workspace. There is no global bot token shared between brands.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

# INTELLIGENCE — optional hosted SaaS integration.
# All five vars must be set for the Intelligence menu item / billing flow
# to appear. Leave any blank to keep Studio in vanilla OSS mode (no Stripe,
# no left-nav Intelligence entry, no /orgs/<id>/intelligence/ URLs).
# - INTELLIGENCE_INTERNAL_URL: hosted Intelligence's /internal/v1/ base
# - INTELLIGENCE_PUBLIC_URL:   hosted Intelligence's /v1/ base
# - STUDIO_DEPLOYMENT_ID:      must match the value registered on the
#                              Intelligence side via register_studio_deployment
# - STUDIO_SHARED_SECRET:      HMAC secret for this deployment (Intelligence-issued)
# - STUDIO_BASE_URL:           https:// URL of THIS Studio deployment.
#                              Validated at boot — non-https raises
#                              ImproperlyConfigured.
INTELLIGENCE_INTERNAL_URL=
INTELLIGENCE_PUBLIC_URL=
STUDIO_DEPLOYMENT_ID=
STUDIO_SHARED_SECRET=
STUDIO_BASE_URL=

# MCP OAUTH — optional. The /api/v1/mcp endpoint accepts a native OAuth login
# (e.g. Claude Desktop → "Add custom connector") in addition to bb_studio_ API
# keys. Both URLs default to APP_URL; set them only for a split app/api
# deployment. In production they must be the public https origin Claude reaches.
# MCP_PUBLIC_BASE_URL=https://your-studio.example.com
# MCP_OAUTH_ISSUER_URL=https://your-studio.example.com


# Signs outbound notification webhooks; share it with receivers so they can verify X-Signature-256.
WEBHOOK_SECRET=

# BLOG PUBLISHING — the "Blog" section commits approved posts to the websites'
# GitHub repositories and starts their deploy workflow. Use a fine-grained
# personal access token restricted to hemantsatishjadhav06-ai/neopolis-site-deploy
# and hemantsatishjadhav06-ai/morespace-website with repository permissions
# "Contents: Read and write" and "Actions: Read and write" (Metadata: read is
# added automatically). Leave empty to keep publishing switched off.
BLOG_GITHUB_TOKEN=

# AI PICTURES FOR BLOG POSTS — the editor's "Generate picture" button asks
# fal.ai for a wordless 16:9 picture (the designed cover adds the title itself).
# Key from https://fal.ai/dashboard/keys. Leave empty to keep the button off.
FAL_KEY=
# Any fal.run text-to-image model: fal-ai/flux/schnell (fastest, cheapest),
# fal-ai/flux/dev (default), fal-ai/flux-pro/v1.1 (finest).
# The AI Studio's illustrator uses the same key and model.
FAL_IMAGE_MODEL=fal-ai/flux/dev

# BLOG RANKINGS (Google Search Console) — shows clicks, impressions and average
# position per article and feeds the SEO monitor. In Google Cloud Console enable
# the "Google Search Console API", create an OAuth client of type "Web
# application" and add exactly one authorised redirect URI:
#   {APP_URL}/blog/search-console/callback/
# A workspace owner then connects each website from Blog → Google Search (read-only
# access; the refresh token is stored encrypted). Leave empty to keep it off.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
# INDEXNOW — optional. Any 8–128 letters/digits/dashes (e.g. a UUID without
# braces). When set, each blog publish adds <key>.txt at the website's root and
# tells Bing and the other IndexNow engines once the post is live.
INDEXNOW_KEY=

# AI STUDIO — a team of agents turns a small idea into a post (angles,
# copy, a designed graphic in the look of the last post) and sends it for
# human approval. Choose the provider and set its key on the web AND worker
# services. Anthropic: https://console.anthropic.com; OpenRouter:
# https://openrouter.ai/settings/keys. An OpenRouter key cannot be used as an
# Anthropic key. Leave keys empty to keep the Studio switched off.
STUDIO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional: the model every agent uses (empty = the provider's default).
# Anthropic defaults to claude-opus-5-5; OpenRouter to
# anthropic/claude-sonnet-4.5. OpenRouter requires a namespaced model ID.
# One effort level for all agents
# (low | medium | high | xhigh | max; empty = each agent's own), the seconds an
# agent turn may take, and Anthropic's server-side fallback for false refusals.
STUDIO_MODEL=
STUDIO_EFFORT=
STUDIO_TIMEOUT=300
STUDIO_FALLBACKS=true
# Optional: let the moments scout and the SEO strategist search the web first
# (Anthropic's web search tool, billed per search). Off by default; unavailable
# with OpenRouter, which uses supplied facts rather than claiming live research.
STUDIO_WEB_SEARCH=false
# Optional: how many briefs autopilot lets the team work on at once across all
# workspaces, so the single worker keeps publishing on time.
AGENCY_MAX_ACTIVE_BRIEFS=3
