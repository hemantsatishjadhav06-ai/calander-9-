{
  "name": "SM Bean",
  "description": "Open-source social media management platform",
  "repository": "https://github.com/hemantsatishjadhav06-ai/calander-9-",
  "keywords": [
    "django",
    "social-media",
    "management"
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    },
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    },
    {
      "plan": "heroku-redis:mini"
    }
  ],
  "env": {
    "SECRET_KEY": {
      "generator": "secret"
    },
    "ENCRYPTION_KEY_SALT": {
      "generator": "secret"
    },
    "DJANGO_SETTINGS_MODULE": {
      "value": "config.settings.production"
    },
    "ALLOWED_HOSTS": {
      "description": "Public hostname of this application, e.g. your-app.herokuapp.com (no scheme or wildcard).",
      "required": true
    },
    "APP_URL": {
      "description": "Public HTTPS origin of this application, e.g. https://your-app.herokuapp.com.",
      "required": true
    },
    "STORAGE_BACKEND": {
      "value": "s3"
    },
    "S3_ENDPOINT_URL": {
      "description": "S3-compatible endpoint URL",
      "required": false
    },
    "S3_ACCESS_KEY_ID": {
      "description": "S3 access key",
      "required": true
    },
    "S3_SECRET_ACCESS_KEY": {
      "description": "S3 secret key",
      "required": true
    },
    "S3_BUCKET_NAME": {
      "description": "S3 bucket name",
      "required": true
    },
    "S3_REGION_NAME": {
      "description": "Region of your S3 bucket.",
      "value": "us-east-1"
    },
    "EMAIL_HOST": {
      "description": "Transactional SMTP host. Configure email before opening signup.",
      "required": false
    },
    "EMAIL_HOST_USER": {
      "description": "Transactional SMTP username.",
      "required": false
    },
    "EMAIL_HOST_PASSWORD": {
      "description": "Transactional SMTP password.",
      "required": false
    },
    "DEFAULT_FROM_EMAIL": {
      "description": "Verified sender email address.",
      "required": false
    },
    "BB_TRUSTED_PROXIES": {
      "description": "Trusted platform proxy IPs/CIDR ranges; configure using your host networking documentation.",
      "required": false
    },
    "ACCOUNT_EMAIL_VERIFICATION": {
      "description": "Change to mandatory after mail delivery is verified.",
      "value": "none"
    }
  },
  "scripts": {
    "postdeploy": "python manage.py check --deploy && python manage.py migrate --noinput"
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "heroku/python"
    }
  ]
}
