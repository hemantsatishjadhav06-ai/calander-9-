{$APP_DOMAIN:localhost} {
    # Uploaded media (STORAGE_BACKEND=local) lives on the media_data volume,
    # which docker-compose.prod.yml mounts read-only here. Serving it from
    # Caddy keeps large images and video off the Gunicorn worker threads and
    # gives byte-range requests, which django.views.static.serve does not
    # implement — without 206 responses a <video> can't be seeked and Safari
    # often refuses to play it at all.
    #
    # With STORAGE_BACKEND=s3 this block rejects all media requests, including
    # old uploads left on the volume after a storage migration.
    handle_path /media/* {
        # These bypass Django, so SecurityMiddleware never sees them. Repeat
        # the two headers config/settings/production.py would have set, or
        # uploads become the one public path on the origin served without
        # them. Keep in step with SECURE_CONTENT_TYPE_NOSNIFF and
        # SECURE_HSTS_* there.
        header {
            X-Content-Type-Options nosniff
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        }

        # MEDIA_ROOT is an env var everywhere else, but the media_data volume
        # is mounted here at a fixed path, so the default has to match
        # .env.example's MEDIA_ROOT=/app/media. Changing one without the other
        # makes uploads 404 at the proxy, without ever reaching Django's own
        # /media/ route.
        #
        # Production Compose passes STORAGE_BACKEND to the matcher below so
        # switching to S3 retires the old public uploads automatically.
        root * {$CADDY_MEDIA_ROOT:/app/media}

        # Only the public subtrees. MEDIA_ROOT also holds private uploads
        # (comment_attachments/, csv_imports/, ...) that Django serves solely
        # through auth-checked views; a bare file_server here would hand them
        # to anyone with the URL. Keep in step with PUBLIC_MEDIA_PREFIXES in
        # config/urls.py. handle_path has already stripped /media, so these
        # paths are relative to MEDIA_ROOT.
        @public_media {
            path /media_library/* /avatars/* /workspaces/icons/*
            # A persistent volume can retain old uploads after switching to S3.
            # Stop serving them automatically when the active backend changes.
            expression `"{$STORAGE_BACKEND:local}" == "local"`
        }
        handle @public_media {
            file_server
        }
        handle {
            respond 404
        }
    }

    handle {
        reverse_proxy app:8000
    }

    encode gzip
}
